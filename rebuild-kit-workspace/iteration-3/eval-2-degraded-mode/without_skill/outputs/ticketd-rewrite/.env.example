# Copy to .env and fill in for local dev. Real production values are not
# known yet (no prod access at time of writing) — do not assume these
# defaults are correct for production.

DATABASE_URL=postgresql+asyncpg://ticketd:ticketd@localhost:5432/ticketd
SMTP_HOST=smtp.internal
SMTP_PORT=25
SMTP_FROM=ticketd@example.internal
NOTIFY_WATCHERS_EMAIL=watchers@example.internal
RESET_WINDOW_MINUTES=30
RATE_LIMIT_PER_HOUR=3
OUTBOX_POLL_INTERVAL_SECONDS=2
