#!/bin/sh
# rebuild-kit guard: the legacy tree is read-only evidence.
# The very first commit (no HEAD yet) is the scaffold commit that adds legacy/
# for the first time — that's the pin, not a modification, so it's allowed.
# Every commit after that must not touch legacy/ at all.
LEGACY_DIR="ticketd"
if git rev-parse --verify -q HEAD >/dev/null; then
  # Matches both plain tracked files under $LEGACY_DIR/... AND a bare gitlink
  # pointer update to $LEGACY_DIR itself (the nested-clone pin re-pointed to a
  # different commit) -- the bare-name case is NOT caught by a "$LEGACY_DIR/"
  # prefix match and was verified to slip through undetected during P0 testing.
  if git diff --cached --name-only | grep -qE "^${LEGACY_DIR}(/|\$)"; then
    echo "REJECTED: staged changes under $LEGACY_DIR/ (or a re-pin of it) — the legacy tree is read-only evidence." >&2
    echo "If legacy itself must change, that happens upstream; re-pin deliberately via rebuild.json.legacy_ref." >&2
    exit 1
  fi
fi
exit 0
